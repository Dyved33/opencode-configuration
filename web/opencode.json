{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B (Locale)"
        },
        "qwen2.5:3b": {
          "name": "Qwen 2.5 3B (Locale)"
        },
        "qwen2.5:1.5b": {
          "name": "Qwen 2.5 1.5B (Locale)"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (Locale)"
        },
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B (Locale)"
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B (Locale)"
        },
        "llama3.2:3b": {
          "name": "Llama 3.2 3B (Locale)"
        },
        "llama3.2:1b": {
          "name": "Llama 3.2 1B (Locale)"
        },
        "gemma2:9b": {
          "name": "Gemma 2 9B (Locale)"
        },
        "gemma2:2b": {
          "name": "Gemma 2 2B (Locale)"
        }
      }
    }
  },
  "default_agent": "webdev",
  "instructions": [
    ".opencode/style.md",
    "~/.config/opencode/vendor/i-have-adhd/skills/i-have-adhd/SKILL.md",
    "~/.config/opencode/skills/no-ai-slop/SKILL.md"
  ],
  "small_model": "ollama/qwen2.5:7b",
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@plannotator/opencode@latest",
    "@azumag/opencode-rate-limit-fallback@2.1.0"
  ],
  "compaction": {
    "auto": true
  },
  "permission": {
    "external_directory": {
      "*": "deny"
    },
    "doom_loop": "deny",
    "edit": {
      "*": "allow",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      "Opencode_Guide.md": "deny",
      ".opencode/**": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "deny",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git rebase*": "ask",
      "*deploy*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "yarn publish*": "deny",
      "vercel*": "deny",
      "netlify*": "deny",
      "wrangler*": "deny",
      "flyctl*": "deny",
      "heroku*": "deny",
      "kubectl*": "deny",
      "docker push*": "deny",
      "gh release*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "question": "allow",
    "todowrite": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    }
  }
}
