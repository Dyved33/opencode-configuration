{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen 2.5 7B (Locale)"
        },
        "qwen2.5:3b": {
          "name": "Qwen 2.5 3B (Locale)"
        },
        "qwen2.5:1.5b": {
          "name": "Qwen 2.5 1.5B (Locale)"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (Locale)"
        },
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B (Locale)"
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B (Locale)"
        },
        "llama3.2:3b": {
          "name": "Llama 3.2 3B (Locale)"
        },
        "llama3.2:1b": {
          "name": "Llama 3.2 1B (Locale)"
        },
        "gemma2:9b": {
          "name": "Gemma 2 9B (Locale)"
        },
        "gemma2:2b": {
          "name": "Gemma 2 2B (Locale)"
        }
      }
    }
  },
  "default_agent": "notes",
  "instructions": [
    ".opencode/style.md",
    "~/.config/opencode/vendor/i-have-adhd/skills/i-have-adhd/SKILL.md",
    "~/.agents/skills/no-ai-slop/SKILL.md"
  ],
  "agents": {
    "title": {
      "model": "ollama/qwen2.5:7b"
    },
    "compaction": {
      "model": "ollama/qwen2.5:7b"
    }
  },
  "lsp": false,
  "formatter": false,
  "plugins": [
    "opencode-parser",
    "@tarquinen/opencode-dcp@latest",
    "@plannotator/opencode@latest",
    "@azumag/opencode-rate-limit-fallback@2.1.0"
  ],
  "mcp": {
    "servers": {
      "obsidian-search": {
        "type": "remote",
        "url": "http://127.0.0.1:8848/mcp",
        "disabled": false
      }
    }
  },
  "compaction": {
    "auto": true
  },
  "experimental": {
    "todo": true
  },
  "watcher": {
    "ignore": [
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.pdf",
      "**/*.ppt",
      "**/*.pptx",
      ".git/**",
      "**/node_modules/**"
    ]
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "doom_loop", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*.md", "effect": "allow" },
    { "action": "edit", "resource": "*/esercizi/*", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "Opencode_Guide.md", "effect": "deny" },
    { "action": "edit", "resource": "chat_prompt.md", "effect": "deny" },
    { "action": "edit", "resource": "opencode.json", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "python3 .opencode/scripts/vault-audit.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/read-slides.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/books.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/check-losses.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/split-notes.py*", "effect": "allow" },
    { "action": "shell", "resource": "python3 .opencode/scripts/split-notes.py*--write*", "effect": "ask" },
    { "action": "shell", "resource": "pdfinfo*", "effect": "allow" },
    { "action": "shell", "resource": "pdftotext*", "effect": "allow" },
    { "action": "shell", "resource": "pdftoppm*", "effect": "ask" },
    { "action": "shell", "resource": "tesseract*", "effect": "allow" },
    { "action": "shell", "resource": "ls*", "effect": "allow" },
    { "action": "shell", "resource": "wc*", "effect": "allow" },
    { "action": "shell", "resource": "grep*", "effect": "allow" },
    { "action": "shell", "resource": "rg*", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "obsidian-mcp-search status*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" }
  ]
}
